# ── Node / Electron (app/) ─────────────────────────────────────────────
node_modules/
app/dist/
app/dist-electron/
app/.vite/
# Logs PID-nomeados do Chromium quando se lanca o exe com --enable-logging
/app/[0-9]*
# tsc -b emite .js/.tsbuildinfo ao lado dos fontes .ts (Vite faz o bundle real)
/app/**/*.js
/app/tsconfig.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ── Build outputs ──────────────────────────────────────────────────────
build/
# App empacotado entregue por build-app.ps1 — artefato grande, regeneravel
/Aplicativo/
# Core compilado pelo build_core.ps1 — artefato regeneravel, nao versionar
app/resources/gerencie_carteira_core.exe
*.spec

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# ── Runtime / dados locais ─────────────────────────────────────────────
log/
*.log
# Pasta de trabalho do modo dev (planilhas/html/logs/publica locais)
data/

# ── Windows / editores ─────────────────────────────────────────────────
Thumbs.db
Desktop.ini
*.swp
.idea/
.vscode/
