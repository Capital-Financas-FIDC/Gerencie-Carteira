{
  "name": "gerencie-carteira-app",
  "productName": "Gerencie Carteira",
  "version": "4.2.8",
  "description": "Automacao Gerencie Carteira — aplicativo desktop (Electron + React).",
  "main": "dist-electron/main.js",
  "author": "Capital Financas",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "dist:portable": "npm run dist:dir && node -e \"require('child_process').execSync('powershell -Command \\\"Compress-Archive -Path \\\"../build/dist-electron/win-unpacked/*\\\" -DestinationPath \\\"../build/dist-electron/Gerencie_Carteira_portable.zip\\\" -Force\\\"', {stdio: 'inherit'})\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "br.com.capitalfinancas.gerencie-carteira",
    "productName": "Gerencie Carteira",
    "directories": {
      "output": "../build/dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/gerencie_carteira_core.exe",
        "to": "gerencie_carteira_core.exe"
      },
      {
        "from": "../config/config.ini",
        "to": "config/config.ini"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gerencie Carteira"
    }
  }
}
